# Postgres connection (Neon: pooled URL here)
DATABASE_URL="postgresql://user:password@host:5432/researchos"
# Direct (non-pooled) URL used for migrations. Same as DATABASE_URL for plain Postgres.
DIRECT_URL="postgresql://user:password@host:5432/researchos"
# Login password for the single owner account
OWNER_PASSWORD="change-me"
# Random secret (32+ chars) used to sign session cookies
AUTH_SECRET="generate-a-long-random-string"
